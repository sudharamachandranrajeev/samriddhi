{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Samriddhi",
  "version": "0.1.0",
  "identifier": "dev.brahma.samriddhi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Samriddhi",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCMTlGRkM1N0Q0Rjk1NjkKUldScGxVOTl4ZjhaSzEwaGV4YjRKOGZuV3QvcFpDelllTDBtZ2oyRXBZNEtQamJSczV1Z1JtMHMK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/sudharamachandranrajeev/samriddhi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
